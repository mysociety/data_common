#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"

run=(uv run --extra dataset --extra render --group test)
lint_paths=(
    tests
    src/data_common/dataset
    src/data_common/management
    src/data_common/notebookcli
)

"${run[@]}" pytest
"${run[@]}" ruff check "${lint_paths[@]}"
"${run[@]}" ruff format "${lint_paths[@]}" --check
"${run[@]}" pyright
